#
# RUN apt-get update && apt-get install -y \
#     libssl-dev \
#     && rm -rf /var/lib/apt/lists/*
#
# WORKDIR /server
# COPY ./WindroseServer .
#
# EXPOSE 7777/udp
# CMD ["./WindroseServer.sh", "-log"]
