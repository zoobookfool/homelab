# homeserver.yaml.example
# 初回起動時に以下のコマンドで自動生成されます：
# docker compose -f compose/element.yml run --rm synapse generate
#
# 生成後に最低限以下の項目を確認・編集してください

# サーバ名（ドメイン名と一致させること・後から変更不可）
server_name: "example.com"

# データベース設定
database:
  name: psycopg2
  args:
    user: synapse
    password: "<SYNAPSE_DB_PASSWORD>"
    database: synapse
    host: synapse-db
    cp_min: 5
    cp_max: 10

# メディアファイルの保存場所
media_store_path: /data/media_store

# 登録を無効化（招待制にする場合）
enable_registration: false

# フェデレーションを有効化
federation_domain_whitelist: ~

# ログ設定
log_config: "/data/example.com.log.config"

# 署名鍵（自動生成されます）
signing_key_path: "/data/example.com.signing.key"
