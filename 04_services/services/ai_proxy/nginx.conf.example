# ローカルPC（自宅PC）の Ollama へのリバースプロキシ
# LOCAL_PC_TAILSCALE_IP と OLLAMA_PORT は .env で設定する

server {
    listen 11435;

    location / {
        proxy_pass http://${LOCAL_PC_TAILSCALE_IP}:${OLLAMA_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # ストリーミングレスポンス対応
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}
