# =============================================================
# homelab サービス共通設定
# このファイルをコピーして .env を作成し、各値を設定してください
# cp .env.example .env
# .env は Git にコミットしないこと（.gitignore で除外済み）
# =============================================================

# -------------------------------------------------------------
# 共通設定
# -------------------------------------------------------------

# ベースドメイン（取得したドメイン名）
# 例: example.com
DOMAIN=example.com

# タイムゾーン
TZ=Asia/Tokyo

# -------------------------------------------------------------
# Mastodon
# https://mastodon.example.com
# -------------------------------------------------------------

# シークレットキー
# ⚠️ コンテナを起動する前に設定すること。「rake secret」は Rails の起動（＝有効な
# SECRET_KEY_BASE）を必要とするため、未設定のまま起動→生成しようとすると
# 「起動できない→生成できない」の鶏と卵に陥る。openssl で同等の値を起動不要で生成できる
# openssl rand -hex 64
MASTODON_SECRET_KEY_BASE=

# OTP シークレット（SECRET_KEY_BASE とは別の値で、同じ方法で生成すること）
MASTODON_OTP_SECRET=

# データベース暗号化キー（3つとも別の値にすること。生成方法は上記と同じ）
# ⚠️ 一度設定したら変更不可（変更すると既存の暗号化済みデータが復号できなくなる）
# ⚠️ 変数名に MASTODON_ 接頭辞を付けないこと（compose/mastodon.yml の env_file 経由で
# Mastodon コンテナにそのままの名前で渡す仕組みのため）
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=

# Vapid キー（以下のコマンドで生成）
# ⚠️ こちらは逆に、コンテナが正常起動した後でないと実行できない
# （生成後は .env に追記し、mastodon-web / mastodon-sidekiq を再作成して反映すること）
# docker compose --env-file .env -f compose/mastodon.yml run --rm mastodon-web bundle exec rake mastodon:webpush:generate_vapid_key
MASTODON_VAPID_PRIVATE_KEY=
MASTODON_VAPID_PUBLIC_KEY=

# データベース
MASTODON_DB_PASSWORD=

# メール送信（SendGrid 等の外部 SMTP を使用）
MASTODON_SMTP_SERVER=smtp.sendgrid.net
MASTODON_SMTP_PORT=587
MASTODON_SMTP_LOGIN=apikey
MASTODON_SMTP_PASSWORD=
MASTODON_SMTP_FROM_ADDRESS=noreply@example.com

# 踏み台/リレーサーバ経由で公開する場合のみ設定（05_relay 構成）
# 未設定だとログイン時に ActionDispatch::RemoteIp::IpSpoofAttackError で 500 エラーになる
# 値はリレーサーバの Tailscale IP（こちらも MASTODON_ 接頭辞を付けない）
TRUSTED_PROXY_IP=

# -------------------------------------------------------------
# Element（Matrix Synapse）
# https://element.example.com
# -------------------------------------------------------------

# Matrix サーバ名（公開URL「matrix.<ドメイン>」と同じにする・後から変更不可）
# 本リポジトリの Nginx 設定は matrix.<ドメイン> で公開する構成のため、
# 素のドメイン名ではなく matrix. を付けた値を設定すること
# （.well-known/matrix/server による delegation は未設定）
# 例: matrix.example.com
MATRIX_SERVER_NAME=matrix.example.com

# データベース（生成後の homeserver.yaml の database.args.password にも同じ値を設定すること）
SYNAPSE_DB_PASSWORD=

# 備考: registration_shared_secret は .env では管理しません。
# `docker compose --env-file .env -f compose/element.yml run --rm synapse generate` を実行すると
# homeserver.yaml 内に自動生成され、そちらが実際に使用されます。

# -------------------------------------------------------------
# 監視ダッシュボード（Grafana）
# https://monitoring.example.com
# -------------------------------------------------------------

# Grafana 管理者パスワード
GRAFANA_ADMIN_PASSWORD=

# -------------------------------------------------------------
# Discord Bot
# -------------------------------------------------------------

# Discord Bot トークン（Discord Developer Portal で取得）
DISCORD_BOT_TOKEN=

# 死活通知を送るチャンネル ID
DISCORD_NOTIFY_CHANNEL_ID=

# -------------------------------------------------------------
# ローカル AI 踏み台
# https://ai.example.com
# -------------------------------------------------------------

# 自宅 PC の Tailscale IP アドレス
# https://login.tailscale.com/admin/machines で確認
# 例: 100.x.x.x
LOCAL_PC_TAILSCALE_IP=

# Ollama の待受ポート（デフォルト: 11434）
OLLAMA_PORT=11434

# -------------------------------------------------------------
# ゲームサーバ（Factorio）
# -------------------------------------------------------------

# サーバ名（ゲーム内に表示される名前）
FACTORIO_SERVER_NAME=My Factorio Server

# サーバパスワード（空欄で公開サーバ）
FACTORIO_SERVER_PASSWORD=

# -------------------------------------------------------------
# ゲームサーバ（Windrose / UE5）
# -------------------------------------------------------------

# サーバポート（デフォルト: 7777）
WINDROSE_PORT=7777
