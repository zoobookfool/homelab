# =============================================================
# homelab サービス共通設定
# このファイルをコピーして .env を作成し、各値を設定してください
# cp .env.example .env
# .env は Git にコミットしないこと（.gitignore で除外済み）
# =============================================================

# -------------------------------------------------------------
# 共通設定
# -------------------------------------------------------------

# ベースドメイン（取得したドメイン名）
# 例: example.com
DOMAIN=example.com

# タイムゾーン
TZ=Asia/Tokyo

# -------------------------------------------------------------
# Mastodon
# https://mastodon.example.com
# -------------------------------------------------------------

# シークレットキー（以下のコマンドで生成）
# docker compose -f compose/mastodon.yml run --rm web bundle exec rake secret
MASTODON_SECRET_KEY_BASE=

# OTP シークレット（同上）
MASTODON_OTP_SECRET=

# Vapid キー（以下のコマンドで生成）
# docker compose -f compose/mastodon.yml run --rm web bundle exec rake mastodon:webpush:generate_vapid_key
MASTODON_VAPID_PRIVATE_KEY=
MASTODON_VAPID_PUBLIC_KEY=

# データベース
MASTODON_DB_PASSWORD=

# メール送信（SendGrid 等の外部 SMTP を使用）
MASTODON_SMTP_SERVER=smtp.sendgrid.net
MASTODON_SMTP_PORT=587
MASTODON_SMTP_LOGIN=apikey
MASTODON_SMTP_PASSWORD=
MASTODON_SMTP_FROM_ADDRESS=noreply@example.com

# -------------------------------------------------------------
# Element（Matrix Synapse）
# https://element.example.com
# -------------------------------------------------------------

# Matrix サーバ名（ドメイン名と同じにする）
# 例: example.com
MATRIX_SERVER_NAME=example.com

# Synapse の秘密鍵（以下のコマンドで生成）
# docker compose -f compose/element.yml run --rm synapse generate
SYNAPSE_REGISTRATION_SHARED_SECRET=

# データベース
SYNAPSE_DB_PASSWORD=

# -------------------------------------------------------------
# 監視ダッシュボード（Grafana）
# https://monitoring.example.com
# -------------------------------------------------------------

# Grafana 管理者パスワード
GRAFANA_ADMIN_PASSWORD=

# -------------------------------------------------------------
# Discord Bot
# -------------------------------------------------------------

# Discord Bot トークン（Discord Developer Portal で取得）
DISCORD_BOT_TOKEN=

# 死活通知を送るチャンネル ID
DISCORD_NOTIFY_CHANNEL_ID=

# -------------------------------------------------------------
# ローカル AI 踏み台
# https://ai.example.com
# -------------------------------------------------------------

# 自宅 PC の Tailscale IP アドレス
# https://login.tailscale.com/admin/machines で確認
# 例: 100.x.x.x
LOCAL_PC_TAILSCALE_IP=

# Ollama の待受ポート（デフォルト: 11434）
OLLAMA_PORT=11434

# -------------------------------------------------------------
# ゲームサーバ（Factorio）
# -------------------------------------------------------------

# サーバ名（ゲーム内に表示される名前）
FACTORIO_SERVER_NAME=My Factorio Server

# サーバパスワード（空欄で公開サーバ）
FACTORIO_SERVER_PASSWORD=

# -------------------------------------------------------------
# ゲームサーバ（Windrose / UE5）
# -------------------------------------------------------------

# サーバポート（デフォルト: 7777）
WINDROSE_PORT=7777
